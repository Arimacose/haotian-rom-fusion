From 8e789100bdc46cd2f9889ca81378117121dbbdee Mon Sep 17 00:00:00 2001
From: Arimacose <Arimacose@users.noreply.github.com>
Date: Thu, 6 Aug 2026 12:21:22 +0800
Subject: [PATCH] haotian: restore CS40L26 calibration from persist

---
 vibrator/Vibrator.cpp                         | 75 ++++++++++++++++++-
 vibrator/Vibrator.h                           |  1 +
 ...hardware.vibrator-service.xiaomi-sm8750.rc | 19 +++++
 3 files changed, 93 insertions(+), 2 deletions(-)

diff --git a/vibrator/Vibrator.cpp b/vibrator/Vibrator.cpp
index 2c88d89..504b480 100644
--- a/vibrator/Vibrator.cpp
+++ b/vibrator/Vibrator.cpp
@@ -8,6 +8,8 @@
 
 #include "Vibrator.h"
 
+#include <android-base/file.h>
+#include <android-base/strings.h>
 #include <android/binder_status.h>
 #include <dirent.h>
 #include <fcntl.h>
@@ -36,6 +38,14 @@ constexpr char kInputDir[] = "/dev/input";
 constexpr char kInputPrefix[] = "event";
 constexpr char kSysfsInputDir[] = "/sys/class/input";
 constexpr char kVibeStateSuffix[] = "/device/default/vibe_state";
+constexpr char kPersistF0Path[] = "/mnt/vendor/persist/haptics/vib_cal_f0";
+constexpr char kPersistRedcPath[] = "/mnt/vendor/persist/haptics/vib_cal_z";
+constexpr char kPersistQPath[] = "/mnt/vendor/persist/haptics/vib_cal_q";
+constexpr char kCalibrationF0Suffix[] = "/calibration/f0_stored";
+constexpr char kCalibrationRedcSuffix[] = "/calibration/redc_stored";
+constexpr char kCalibrationQSuffix[] = "/calibration/q_stored";
+constexpr char kF0CompEnableSuffix[] = "/default/f0_comp_enable";
+constexpr char kRedcCompEnableSuffix[] = "/default/redc_comp_enable";
 constexpr int16_t kInvalidEffect = -1;
 constexpr uint16_t kBuzzPeriodMs = 5;
 constexpr uint16_t kRamWaveformBank = 0;
@@ -87,6 +97,29 @@ bool isSupportedInputName(const char *name) {
          strcmp(name, "cs40l26_dual_input") == 0;
 }
 
+bool readCalibrationValue(const char *path, std::string *value) {
+  std::string contents;
+  if (!::android::base::ReadFileToString(path, &contents)) {
+    ALOGW("Failed to open persist file: %s", path);
+    return false;
+  }
+
+  *value = ::android::base::Trim(contents);
+  if (value->empty()) {
+    ALOGW("Persist calibration file is empty: %s", path);
+    return false;
+  }
+  return true;
+}
+
+bool writeCalibrationValue(const std::string &path, const std::string &value) {
+  if (!::android::base::WriteStringToFile(value, path)) {
+    ALOGE("Failed to open sysfs node: %s", path.c_str());
+    return false;
+  }
+  return true;
+}
+
 ndk::ScopedAStatus unsupported() {
   return ndk::ScopedAStatus::fromExceptionCode(EX_UNSUPPORTED_OPERATION);
 }
@@ -184,9 +217,12 @@ bool Vibrator::openInputLocked() {
     mHasGain = testBit(FF_GAIN, ffBits);
     const char *eventName = strrchr(path.c_str(), '/');
     eventName = eventName == nullptr ? path.c_str() : eventName + 1;
-    mVibeStatePath =
-        std::string(kSysfsInputDir) + "/" + eventName + kVibeStateSuffix;
+    const std::string sysfsInputPath =
+        std::string(kSysfsInputDir) + "/" + eventName + "/device";
+    mVibeStatePath = std::string(kSysfsInputDir) + "/" + eventName +
+                     kVibeStateSuffix;
     mHasVibeState = access(mVibeStatePath.c_str(), R_OK) == 0;
+    loadCalibrationLocked(sysfsInputPath);
     ALOGI("Using %s at %s, custom=%d gain=%d sine=%d period=%ums",
           mInputName.c_str(), mInputPath.c_str(), mHasCustom, mHasGain,
           testBit(FF_SINE, ffBits), kBuzzPeriodMs);
@@ -200,6 +236,41 @@ bool Vibrator::openInputLocked() {
   return false;
 }
 
+bool Vibrator::loadCalibrationLocked(const std::string &sysfsInputPath) {
+  if (sysfsInputPath.empty() || access(sysfsInputPath.c_str(), F_OK) != 0) {
+    ALOGE("Failed to determine calibration sysfs path!");
+    return false;
+  }
+
+  std::string f0;
+  std::string redc;
+  std::string q;
+  if (!readCalibrationValue(kPersistF0Path, &f0) ||
+      !readCalibrationValue(kPersistRedcPath, &redc) ||
+      !readCalibrationValue(kPersistQPath, &q)) {
+    ALOGW("Calibration data missing from persist, skipping loader.");
+    return false;
+  }
+
+  bool success = true;
+  success &= writeCalibrationValue(sysfsInputPath + kCalibrationF0Suffix, f0);
+  success &=
+      writeCalibrationValue(sysfsInputPath + kCalibrationRedcSuffix, redc);
+  success &= writeCalibrationValue(sysfsInputPath + kCalibrationQSuffix, q);
+  success &= writeCalibrationValue(sysfsInputPath + kF0CompEnableSuffix, "1");
+  success &=
+      writeCalibrationValue(sysfsInputPath + kRedcCompEnableSuffix, "1");
+
+  if (!success) {
+    ALOGE("Failed to write some calibration values to sysfs.");
+    return false;
+  }
+
+  ALOGI("Loaded calibration from persist: f0=%s, redc=%s, q=%s", f0.c_str(),
+        redc.c_str(), q.c_str());
+  return true;
+}
+
 int Vibrator::uploadCachedWaveformLocked(const CachedEffectKey &key) {
   auto cached = mEffectCache.find(key);
   if (cached != mEffectCache.end()) {
diff --git a/vibrator/Vibrator.h b/vibrator/Vibrator.h
index 8ec583b..ae34170 100644
--- a/vibrator/Vibrator.h
+++ b/vibrator/Vibrator.h
@@ -75,6 +75,7 @@ private:
   };
 
   bool openInputLocked();
+  bool loadCalibrationLocked(const std::string &sysfsInputPath);
   int setGainLocked(uint8_t gainPct);
   int uploadCachedWaveformLocked(const CachedEffectKey &key);
   void preloadCachedEffectsLocked();
diff --git a/vibrator/android.hardware.vibrator-service.xiaomi-sm8750.rc b/vibrator/android.hardware.vibrator-service.xiaomi-sm8750.rc
index a58fa79..39a49b8 100644
--- a/vibrator/android.hardware.vibrator-service.xiaomi-sm8750.rc
+++ b/vibrator/android.hardware.vibrator-service.xiaomi-sm8750.rc
@@ -1,3 +1,22 @@
+on boot
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input0/calibration/f0_stored
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input0/calibration/redc_stored
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input0/calibration/q_stored
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input0/default/f0_comp_enable
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input0/default/redc_comp_enable
+
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input1/calibration/f0_stored
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input1/calibration/redc_stored
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input1/calibration/q_stored
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input1/default/f0_comp_enable
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input1/default/redc_comp_enable
+
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input2/calibration/f0_stored
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input2/calibration/redc_stored
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input2/calibration/q_stored
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input2/default/f0_comp_enable
+    chown system system /sys/bus/i2c/drivers/cs40l26/0-0043/input/input2/default/redc_comp_enable
+
 service vendor.vibrator-cs40l26 /vendor/bin/hw/android.hardware.vibrator-service.xiaomi-sm8750
     class hal
     user system
