<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    YAAP 16 platform override: keep the upstream AOSP-first manifest, replace
    the YAAP product repository and point Qualcomm common at managed forks,
    then add the haotian device/common/prebuilt-kernel projects. Proprietary
    vendor trees remain staged from the verified local extraction until their
    LFS repos are published; omitting them here is intentional for the
    manifest-only gate.
  -->
  <remote name="arimacose" fetch="https://github.com/Arimacose/" />

  <remove-project name="vendor_yaap" />
  <remove-project name="hardware_lineage_interfaces" />
  <remove-project name="device_lineage_sepolicy" />

  <project
      path="vendor/yaap"
      name="Arimacose/vendor_yaap"
      remote="github"
      revision="haotian-16" />

  <project
      path="device/xiaomi/haotian"
      name="Arimacose/device_xiaomi_haotian"
      remote="github"
      revision="yaap-16" />
  <project
      path="device/xiaomi/sm8750-common"
      name="Arimacose/device_xiaomi_sm8750-common"
      remote="github"
      revision="yaap-16" />
  <project
      path="device/xiaomi/haotian-kernel"
      name="Arimacose/device_xiaomi_haotian-kernel"
      remote="github"
      revision="yaap-16" />

  <!--
    YAAP sixteen intentionally omits the Lineage charging-control AIDL and
    policy while the haotian common tree packages that service. These forks
    retain only the compatibility surface required by the device tree.
  -->
  <project
      path="hardware/lineage/interfaces"
      name="Arimacose/hardware_lineage_interfaces"
      remote="github"
      revision="haotian-16" />
  <project
      path="device/lineage/sepolicy"
      name="Arimacose/device_lineage_sepolicy"
      remote="github"
      revision="haotian-16" />

  <!-- Qualcomm SM8750/Sun source closure required by sm8750-common. -->
  <project
      path="device/qcom/sepolicy_vndr/sm8750"
      name="LineageOS/android_device_qcom_sepolicy_vndr"
      remote="github"
      revision="lineage-23.2-caf-sm8750" />

  <!--
    The managed Qualcomm common fork classifies sun as the SM8750 UM 6.6
    family. Keep the three SM8750 pickup links on that project; the
    sepolicy_vndr project does not contain these pickup files.
  -->
  <extend-project
      name="hardware_qcom-caf_common"
      path="hardware/qcom-caf/common"
      remote="arimacose"
      revision="haotian-16">
    <linkfile src="os_pickup_audio-ar.mk" dest="hardware/qcom-caf/sm8750/audio/Android.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8750/Android.bp" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/sm8750/Android.mk" />
  </extend-project>
  <extend-project
      name="hardware_qcom-caf_thermal"
      path="hardware/qcom-caf/thermal"
      remote="arimacose"
      revision="haotian-16" />
  <project
      path="hardware/qcom-caf/sm8750/audio/agm"
      name="LineageOS/android_vendor_qcom_opensource_agm"
      remote="github"
      revision="lineage-23.2-caf-sm8750" />
  <project
      path="hardware/qcom-caf/sm8750/audio/graphservices"
      name="LineageOS/android_vendor_qcom_opensource_audioreach-graphservices"
      remote="github"
      revision="lineage-23.2-caf-sm8750" />
  <project
      path="hardware/qcom-caf/sm8750/audio/pal"
      name="LineageOS/android_vendor_qcom_opensource_arpal-lx"
      remote="github"
      revision="lineage-23.2-caf-sm8750" />
  <project
      path="hardware/qcom-caf/sm8750/audio/primary-hal"
      name="LineageOS/android_hardware_qcom_audio-ar"
      remote="github"
      revision="lineage-23.2-caf-sm8750" />
  <project
      path="hardware/qcom-caf/sm8750/data-ipa-cfg-mgr"
      name="LineageOS/android_vendor_qcom_opensource_data-ipa-cfg-mgr"
      remote="github"
      revision="lineage-23.2-caf-sm8750" />
  <project
      path="hardware/qcom-caf/sm8750/dataipa"
      name="LineageOS/android_vendor_qcom_opensource_dataipa"
      remote="github"
      revision="lineage-23.2-caf-sm8750" />
  <project
      path="hardware/qcom-caf/sm8750/display/core"
      name="LineageOS/android_vendor_qcom_opensource_display-core"
      remote="github"
      revision="lineage-23.2-caf-sm8750" />
  <project
      path="hardware/qcom-caf/sm8750/display/hal"
      name="LineageOS/android_hardware_qcom_display"
      remote="github"
      revision="lineage-23.2-caf-sm8750" />
  <project
      path="hardware/qcom-caf/sm8750/display/intf"
      name="LineageOS/android_vendor_qcom_opensource_display-intf"
      remote="github"
      revision="lineage-23.2-caf-sm8750" />

  <project
      path="hardware/xiaomi"
      name="LineageOS/android_hardware_xiaomi"
      remote="github"
      revision="lineage-23.2" />

  <project
      path="packages/apps/EuiccPolicy"
      name="LineageOS/android_packages_apps_EuiccPolicy"
      remote="github"
      revision="lineage-23.2" />

  <project
      path="vendor/qcom/opensource/commonsys/audio"
      name="LineageOS/android_vendor_qcom_opensource_audio"
      remote="github"
      revision="lineage-23.2" />
  <project
      path="vendor/qcom/opensource/commonsys-intf/audio"
      name="LineageOS/android_vendor_qcom_opensource_audio-commonsys-intf"
      remote="github"
      revision="lineage-23.2" />

  <project
      path="vendor/qcom/opensource/libvmmem"
      name="LineageOS/android_vendor_qcom_opensource_libvmmem"
      remote="github"
      revision="lineage-23.2" />
</manifest>
